rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function email() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email
        : '';
    }

    // Administradores do produto. O e-mail vem do token assinado pelo Firebase
    // Authentication; não é aceito nenhum valor enviado pelo navegador.
    function isAdmin() {
      return email() == 'cmo.sep@gmail.com' || email() == 'czkenglish@gmail.com';
    }

    function schoolExists(sid) {
      return sid is string
        && exists(/databases/$(database)/documents/schools/$(sid));
    }

    function ownsSchool(sid) {
      return signedIn()
        && schoolExists(sid)
        && get(/databases/$(database)/documents/schools/$(sid)).data.ownerEmail == email();
    }

    function studentExists(uid) {
      return exists(/databases/$(database)/documents/students/$(uid));
    }

    function studentSchool(uid) {
      return get(/databases/$(database)/documents/students/$(uid)).data.schoolId;
    }

    function isOwnStudent(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function managesStudent(uid) {
      return isAdmin() || (studentExists(uid) && ownsSchool(studentSchool(uid)));
    }

    function belongsToSchool(sid) {
      return signedIn()
        && studentExists(request.auth.uid)
        && studentSchool(request.auth.uid) == sid;
    }

    function studentProfileUpdateIsSafe() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'photo', 'avisosLidos', 'fcmToken', 'fcmTokens',
          'progressMilestones', 'reviewNextPromptAt', 'senha'
        ])
        // A senha legada pode ser apagada, nunca criada nem alterada.
        && (!changed.hasAny(['senha']) || !request.resource.data.keys().hasAny(['senha']));
    }

    function activityUpdateIsSafe() {
      return resource.data.status != 'corrected'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'respostas', 'partsDone', 'conclusao', 'finalizada'
        ]);
    }

    function extraUpdateIsSafe() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'respostas', 'finalizada', 'conclusao', 'finalizadaEm'
      ]);
    }

    // Diretório interno de níveis. Deixou de ser público: contém nome e nível
    // de alunos e só é necessário ao próprio aluno ou à equipe da escola.
    match /niveis/{uid} {
      allow get: if isOwnStudent(uid)
        || isAdmin()
        || (resource.data.schoolId is string && ownsSchool(resource.data.schoolId));
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (request.resource.data.schoolId is string && ownsSchool(request.resource.data.schoolId));
      allow update, delete: if isAdmin()
        || (resource.data.schoolId is string
          && ownsSchool(resource.data.schoolId)
          && (request.method == 'delete'
            || request.resource.data.schoolId == resource.data.schoolId));
    }

    // Biblioteca de atividades extras: não é conteúdo global para alunos.
    match /extras/{extraId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Conteúdo público do desafio para usuários autenticados. Gabaritos e
    // resultados individuais ficam em coleções internas sem regra de leitura.
    match /challengeWeeks/{weekKey} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /challengeRounds/{roundId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Chaves de automação do desafio (geração semanal, entradas tardias e as
    // semanas marcadas como manuais). Só a equipe lê e escreve.
    match /challengeSettings/{doc} {
      allow read, write: if isAdmin();
    }

    match /challengeRankings/{weekKey} {
      allow read: if signedIn() && resource.data.revealAt <= request.time;
      allow write: if isAdmin();
    }

    match /schools/{schoolId} {
      // Aluno só lê a própria escola; professor só a escola que administra.
      allow get: if isAdmin()
        || resource.data.ownerEmail == email()
        || belongsToSchool(schoolId);
      allow list: if isAdmin() || resource.data.ownerEmail == email();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        resource.data.ownerEmail == email()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens'])
      );

      match /avisos/{avisoId} {
        allow read: if isAdmin() || ownsSchool(schoolId) || belongsToSchool(schoolId);
        allow write: if isAdmin() || ownsSchool(schoolId);
      }

      // O professor monta turmas/duplas; os desafios são espelhados de forma
      // privada dentro de cada aluno participante.
      match /classGroups/{groupId} {
        allow read, write: if isAdmin() || ownsSchool(schoolId);
      }

      // Agenda e expediente são privados do professor. Alunos não recebem
      // acesso, inclusive aos compromissos marcados como particulares.
      match /calendarEvents/{eventId} {
        allow read, write: if isAdmin() || ownsSchool(schoolId);
      }

      match /calendarSettings/{settingsId} {
        allow read, write: if isAdmin() || ownsSchool(schoolId);
      }

      // Valores, vencimentos e despesas são exclusivamente administrativos.
      match /financeStudents/{studentUid} {
        allow read, write: if isAdmin() || ownsSchool(schoolId);
      }

      match /financeTransactions/{transactionId} {
        allow read, write: if isAdmin() || ownsSchool(schoolId);
      }

      match /courseReviews/{studentUid} {
        allow read: if isAdmin()
          || ownsSchool(schoolId)
          || (belongsToSchool(schoolId)
            && (resource.data.hidden == false || request.auth.uid == studentUid));

        allow create: if belongsToSchool(schoolId)
          && request.auth.uid == studentUid
          && request.resource.data.keys().hasOnly([
            'studentUid', 'authorName', 'rating', 'comment', 'anonymous',
            'hidden', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.studentUid == request.auth.uid
          && request.resource.data.authorName == get(/databases/$(database)/documents/students/$(request.auth.uid)).data.name
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 600
          && request.resource.data.anonymous is bool
          && request.resource.data.hidden == false
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if (belongsToSchool(schoolId)
          && request.auth.uid == studentUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'rating', 'comment', 'anonymous', 'updatedAt'
          ])
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 600
          && request.resource.data.anonymous is bool
          && request.resource.data.updatedAt == request.time)
          || isAdmin()
          || ownsSchool(schoolId);

        allow delete: if isAdmin() || ownsSchool(schoolId);
      }
    }

    match /students/{uid} {
      allow read: if isOwnStudent(uid) || managesStudent(uid);
      allow create: if isAdmin()
        || (request.resource.data.schoolId is string && ownsSchool(request.resource.data.schoolId));
      allow update: if isAdmin()
        || (ownsSchool(resource.data.schoolId)
          && request.resource.data.schoolId == resource.data.schoolId)
        || (isOwnStudent(uid) && studentProfileUpdateIsSafe());
      allow delete: if managesStudent(uid);

      match /posaulas/{postId} {
        allow read: if isOwnStudent(uid) || managesStudent(uid);
        allow create, delete: if managesStudent(uid);
        allow update: if managesStudent(uid) || (
          isOwnStudent(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        );
      }

      match /activities/{activityId} {
        allow read: if isOwnStudent(uid) || managesStudent(uid);
        allow create, delete: if managesStudent(uid);
        allow update: if managesStudent(uid)
          || (isOwnStudent(uid) && activityUpdateIsSafe());
      }

      match /extras/{extraId} {
        allow read: if isOwnStudent(uid) || managesStudent(uid);
        allow create, delete: if managesStudent(uid);
        allow update: if managesStudent(uid)
          || (isOwnStudent(uid) && extraUpdateIsSafe());
      }

      match /vocabulario/{wordId} {
        allow read: if isOwnStudent(uid) || managesStudent(uid);
        allow write: if managesStudent(uid);
      }

      match /review90Reports/{reportId} {
        allow read: if isOwnStudent(uid) || managesStudent(uid);
        allow create, delete: if managesStudent(uid);
        allow update: if managesStudent(uid) || (
          isOwnStudent(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentViewedAt'])
        );
      }

      // Prévia privada do desafio: somente o próprio aluno e a equipe responsável.
      match /challengePreview/{previewId} {
        allow read: if isOwnStudent(uid) || managesStudent(uid);
        allow write: if managesStudent(uid);
      }

      // Rodadas individualizadas: cada aluno recebe perguntas geradas a partir
      // dos próprios pós-aulas. O gabarito permanece em coleção interna.
      match /challengeRounds/{roundId} {
        allow read: if isOwnStudent(uid) || managesStudent(uid);
        allow write: if managesStudent(uid);
      }

      match /classGroups/{groupId} {
        allow read: if isOwnStudent(uid) || managesStudent(uid);
        allow create, delete: if managesStudent(uid);
        allow update: if managesStudent(uid) || (
          isOwnStudent(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joined', 'joinedAt'])
          && request.resource.data.joined is bool
        );
      }

      // O aluno grava as próprias respostas; pontuação e ranking são calculados
      // pelo servidor. A conclusão também impede lembretes indevidos.
      match /challengeSubmissions/{roundId} {
        allow read: if isOwnStudent(uid) || managesStudent(uid);
        // As respostas entram exclusivamente pelas Cloud Functions. Assim o
        // servidor garante a ordem, a janela de tempo e uma única tentativa.
        allow create, update, delete: if managesStudent(uid);
      }

      // Toda subcoleção nova nasce fechada para o aluno até ganhar uma regra
      // explícita. A equipe da escola continua podendo administrá-la.
      match /{document=**} {
        allow read, write: if managesStudent(uid);
      }
    }

    // Contabilidade e filas são gravadas apenas pelo Admin SDK (servidor).
    match /_apiUsage/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /_creditos/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /_saldoMovimentos/{doc} {
      allow read: if isAdmin()
        || (resource.data.escolaId is string && ownsSchool(resource.data.escolaId));
      allow write: if false;
    }
    match /_batchJobs/{doc} {
      allow read: if isAdmin()
        || (resource.data.escolaId is string && ownsSchool(resource.data.escolaId));
      allow write: if false;
    }
    match /_posaulaJobs/{doc} {
      allow read: if isAdmin()
        || (resource.data.escolaId is string && ownsSchool(resource.data.escolaId));
      allow write: if false;
    }
    match /_correcaoJobs/{doc} {
      allow read: if isAdmin()
        || (resource.data.escolaId is string && ownsSchool(resource.data.escolaId));
      allow write: if false;
    }
    match /_challengeGenerationJobs/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /_challengeLateEntries/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
